{
  "version": 2,
  "builds": [
    {
      "src": "asgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(style.css|app.js|favicon.ico)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "asgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "/static/index.html"
    }
  ]
}
